  },
  {
    "id": "36807950aa0d4eb9b41efe6adb0ef70e",
    "content": "SOURCE_URL: https://ardek.selcuk.edu.tr/2224-b-yurt-ici-bilimsel-etkinliklere-katilimi-destekleme-programi/\nTITLE: 2224-B Yurt İçi Bilimsel Etkinliklere Katılımı Destekleme Programı – Selçuk Üniversitesi Araştırma Dekanlığı\nSCRAPED_AT: 2026-01-17T00:56:30.137889\nCONTENT_HASH: 7d85c0bb5dad3070139d4599330cd1224e40fa44923d601bc30993b3f143df71",

    "id": "71395368739c4546a550c837c17ab76b",
    "content": "Adresi\nŞifre\nBeni hatırla\nŞifrenizi mi unuttunuz?",
    "source": "ardek.selcuk.edu.tr_76381e0c9f.txt",
    "page": null,
    "chunk": 6
  },

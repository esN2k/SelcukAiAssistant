# OMEN 15 (Ryzen 7 5800H + RTX 3060) server profile
# Copy to backend/.env for local use (this file is safe to commit).

# Server
HOST=0.0.0.0
PORT=8000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=turkcell_llm_7b_selcuk_4k
OLLAMA_TIMEOUT=180
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_DELAY=1.0

# RAG
RAG_ENABLED=true
RAG_VECTOR_DB_PATH=./data/rag
RAG_COLLECTION_NAME=selcuk_documents
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=128
RAG_TOP_K=5
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_DEVICE=auto
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_STRICT_DEFAULT=true

# Model routing
MODEL_BACKEND=ollama
MODEL_ALIASES=

# Hugging Face (optional)
HF_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
HF_LOAD_IN_4BIT=true
HF_DEVICE=auto
HF_DTYPE=float16
HF_ATTENTION_IMPL=sdpa
TRANSLATE_MODEL_NAME=google/translategemma-4b-it
HF_TOKEN=

# Guardrails
MAX_CONTEXT_TOKENS=4096
MAX_OUTPUT_TOKENS=512
REQUEST_TIMEOUT=180

# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Analytics
POSTGRES_DSN=
